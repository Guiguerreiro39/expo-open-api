# Copy this file to `.env.local` (or `.env`) and adjust values for your environment.
# All variables are validated via `ClientEnvSchema` in `src/shared/config/env.ts`.

# Base URL for the `hono-open-api` backend (REST, Better Auth, and SSE):
# - iOS Simulator / Web: http://localhost:9999
# - Android Emulator:    http://10.0.2.2:9999
# - Physical device:     http://<your-workstation-lan-ip>:9999
EXPO_PUBLIC_API_URL=http://localhost:9999

# Application version reported to observability adapters
EXPO_PUBLIC_APP_VERSION=0.1.0

# Optional: Sentry Mobile telemetry (leave blank to use Console in dev / Noop in prod)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# Optional: Datadog Mobile RUM telemetry
# EXPO_PUBLIC_DATADOG_APPLICATION_ID=
# EXPO_PUBLIC_DATADOG_CLIENT_TOKEN=
# EXPO_PUBLIC_DATADOG_SITE=datadoghq.com
# EXPO_PUBLIC_DATADOG_SERVICE=expo-open-api-mobile
# EXPO_PUBLIC_DATADOG_SESSION_SAMPLE_RATE=100
