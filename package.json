{
  "name": "expo-open-api",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean --no-install",
    "export": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api": "orval",
    "sync:api": "curl -fsS http://localhost:9999/doc > ./openapi.json && orval",
    "verify:tokens": "node scripts/verify-design-tokens.mjs",
    "prepare": "test -e .git && lefthook install || true"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.27",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-community/netinfo": "11.4.1",
    "@rn-primitives/accordion": "1.2.0",
    "@rn-primitives/alert-dialog": "1.2.0",
    "@rn-primitives/avatar": "1.2.0",
    "@rn-primitives/checkbox": "1.2.0",
    "@rn-primitives/dialog": "1.2.0",
    "@rn-primitives/dropdown-menu": "1.2.0",
    "@rn-primitives/label": "1.2.0",
    "@rn-primitives/popover": "1.2.0",
    "@rn-primitives/portal": "1.2.0",
    "@rn-primitives/progress": "1.2.0",
    "@rn-primitives/radio-group": "1.2.0",
    "@rn-primitives/select": "1.2.0",
    "@rn-primitives/separator": "1.2.0",
    "@rn-primitives/slot": "1.2.0",
    "@rn-primitives/switch": "1.2.0",
    "@rn-primitives/tabs": "1.2.0",
    "@rn-primitives/tooltip": "1.2.0",
    "@tanstack/query-sync-storage-persister": "^5.108.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.5",
    "eventsource-parser": "^4.1.3",
    "expo": "~52.0.49",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.5",
    "expo-network": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^1.77.0",
    "nativewind": "^4.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.14",
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@effect/vitest": "^0.27.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.12",
    "@vitest/coverage-v8": "^4.1.12",
    "lefthook": "^2.2.2",
    "msw": "^2.15.0",
    "orval": "^8.49.0",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "~3.4.19",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "vitest-native": "0.13.0"
  }
}
