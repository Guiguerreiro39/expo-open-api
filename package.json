{
  "name": "expo-open-api",
  "version": "0.1.2",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean --no-install",
    "export": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:api": "orval",
    "sync:api": "curl -fsS http://localhost:9999/doc > ./openapi.json && orval",
    "verify:tokens": "node scripts/verify-design-tokens.mjs",
    "prepare": "test -e .git && lefthook install || true"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.27",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@tanstack/query-sync-storage-persister": "^5.108.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^3.22.5",
    "eventsource-parser": "^4.1.3",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^1.77.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-class-static-block": "^7.29.14",
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@effect/vitest": "^0.30.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "lefthook": "^2.2.2",
    "msw": "^2.15.0",
    "orval": "^8.49.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "vitest-native": "0.14.1"
  }
